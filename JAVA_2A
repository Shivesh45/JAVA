import java.util.ArrayList;
import java.util.Scanner;

public class SumIntegers {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        ArrayList<Integer> numbers = new ArrayList<>();
        System.out.println("Enter integers separated by space:");

        String input = sc.nextLine();
        String[] tokens = input.split("\\s+");

        // Parsing strings into Integer objects (autoboxing occurs automatically)
        for (String token : tokens) {
            int num = Integer.parseInt(token); // parsing string to primitive int
            numbers.add(num); // autoboxing int to Integer
        }

        // Calculating sum using unboxing
        int sum = 0;
        for (Integer number : numbers) {
            sum += number; // unboxing Integer to int
        }

        System.out.println("Sum of integers: " + sum);
        sc.close();
    }
}
